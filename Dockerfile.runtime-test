FROM node:24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  openssl \
  build-essential \
  pkg-config \
  cmake \
  clang \
  perl \
  git \
  linux-perf \
  strace \
  && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain 1.94.0
ENV PATH="/root/.cargo/bin:${PATH}"
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts --no-optional

COPY build.rs Cargo.toml Cargo.lock ./
COPY benches ./benches
COPY src ./src
COPY lib ./lib
COPY scripts ./scripts
COPY test ./test
COPY index.js index.d.ts tsconfig.json tsconfig.test.json ./

RUN pnpm run build
RUN pnpm run build:test

CMD ["node", "--version"]
