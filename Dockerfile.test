ARG NODE_IMAGE=node:24.22.1-trixie-slim@sha256:89c5244bc22a9bc3287d89ebc7e49b9cb5bb84cd40e6175ac3421d5a9f68b95a
FROM ${NODE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  build-essential \
  pkg-config \
  cmake \
  clang \
  perl \
  git \
  && rm -rf /var/lib/apt/lists/*

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal --default-toolchain 1.99.1
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_JOBS=8
RUN npm install -g pnpm@12.16.1

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY examples/hono/package.json ./examples/hono/package.json
COPY examples/express-adapter/package.json ./examples/express-adapter/package.json
COPY examples/workerd-client/package.json ./examples/workerd-client/package.json
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY build.rs Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY benches ./benches
COPY fuzz ./fuzz
COPY tools ./tools
COPY crates ./crates
COPY spikes/quiche-wasm-wasip1 ./spikes/quiche-wasm-wasip1
COPY vendor ./vendor
COPY src ./src
COPY lib ./lib
COPY scripts ./scripts
COPY test ./test
COPY tests ./tests
COPY index.js index.d.ts tsconfig.json tsconfig.test.json ./

RUN pnpm run build
RUN pnpm exec tsc -p tsconfig.test.json

# Run all stress + bench tests
CMD ["sh", "-c", "\
  echo '=== io_uring stress + bench tests ===' && \
  echo '--- quic-stress.test.js ---' && \
  node --test dist-test/test/interop/quic-stress.test.js && \
  echo '--- quic-driver-pressure.test.js ---' && \
  node --test dist-test/test/runtime/quic-driver-pressure.test.js && \
  echo '--- bench-compare.test.js ---' && \
  node --test dist-test/test/perf-gates/bench-compare.test.js && \
  echo '--- quic-bench-profile.test.js ---' && \
  node --test dist-test/test/perf-gates/quic-bench-profile.test.js && \
  echo '=== ALL TESTS PASSED ==='"]
