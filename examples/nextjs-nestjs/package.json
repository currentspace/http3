{
  "name": "http3-nextjs-nestjs-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "certs": "node scripts/certs.cjs",
    "build:server": "tsc -p tsconfig.json",
    "dev": "npm run build:server && node dist/main.js",
    "build": "npm run build:server && next build web",
    "start": "NODE_ENV=production node dist/main.js",
    "test:protocols": "node --test --test-timeout=60000 scripts/protocols.test.mjs scripts/nest-helper.test.mjs",
    "test:browser": "node scripts/browser.cjs"
  },
  "dependencies": {
    "@currentspace/http3": "0.9.8",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "express": "5.3.0",
    "cookie-parser": "1.4.7",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "^24.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "playwright": "1.65.0-alpha-2026-10-29"
  }
}
